prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: keysharp-input
Description: Typed client library for the keysharp-input service
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lkeysharp-input
Cflags: -I${includedir}
