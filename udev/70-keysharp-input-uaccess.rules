# Grant the active session access only to the broker's virtual devices.
ACTION!="add|change", GOTO="keysharp_uaccess_end"
SUBSYSTEM!="input", GOTO="keysharp_uaccess_end"

ATTRS{name}=="Keysharp Virtual Input", TAG+="uaccess"
ATTRS{name}=="Keysharp Virtual Pointer", TAG+="uaccess"

LABEL="keysharp_uaccess_end"
